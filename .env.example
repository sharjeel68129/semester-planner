# Copy this file to .env.local and fill in the real values:
#   copy .env.example .env.local
# .env.local is gitignored. Never commit it, paste it in chat, or screenshot it.
#
# Format: one NAME=value per line. No spaces around "=", no quotes, no trailing spaces.
# Restart "npm run dev" after editing; Next.js only reads this file at startup.

# --- Required ---

# Google Cloud service account for Gemini on Vertex AI (project project-c9b51bf9-6bb8-4e61-b2b; ask the leader).
# Paste the whole service account key JSON on ONE line, as it is (it contains "
" inside the private key: keep them).
# Server-side only. Never prefix with NEXT_PUBLIC_, never save the key file in this folder, never commit it.
# On Vercel, add it as an environment variable with the same name.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Optional ---

# Which Gemini models lib/extract.js tries, in order, separated by commas (default: gemini-3.8-flash only).
# A model that answers 503 or 429 hands over to the next one. The server log says which model answered;
# re-run the sample outlines after changing it, because accuracy differs between models.
# GEMINI_MODELS=gemini-3.8-flash

# --- Accounts and saved events (Supabase) ---
# Required to use the planner: without these two nobody can sign in, and uploads are refused.
# To set them up:
#   1. Create a free project at https://supabase.com (the team shares one; ask the leader).
#   2. In its SQL Editor, run supabase/schema.sql once.
#   3. Copy both values from Project Settings -> API.
# These two ARE meant to carry NEXT_PUBLIC_: they are public values that ship to the browser.
# The rules in supabase/schema.sql protect the data. Never put the "service_role" key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Not used yet ---
# Email reminders are planned but not built, so they need no variables today.
# When they are added, list their variables here in the same commit.
