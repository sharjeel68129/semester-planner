# Copy this file to .env.local and fill in the real values:
#   copy .env.example .env.local
# .env.local is gitignored. Never commit it, paste it in chat, or screenshot it.
#
# Format: one NAME=value per line. No spaces around "=", no quotes, no trailing spaces.
# Restart "npm run dev" after editing; Next.js only reads this file at startup.

# --- Required ---

# Gemini API key (from https://aistudio.google.com/apikey; the team shares one, ask the leader).
# Server-side only. Never prefix with NEXT_PUBLIC_ or the key leaks to browsers.
GEMINI_API_KEY=your-key-here

# --- Optional ---

# Which Gemini models lib/extract.js tries, in order, separated by commas. A model that answers
# 503 "high demand" or 429 hands over to the next one. Leave commented out to use the list pinned there.
# The server log says which model answered; re-run the sample outlines after changing the list,
# because accuracy differs between models.
# (This replaces the old single-model GEMINI_MODEL, which is no longer read.)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# --- Accounts and saved events (Supabase) ---
# Required to use the planner: without these two nobody can sign in, and uploads are refused.
# To set them up:
#   1. Create a free project at https://supabase.com (the team shares one; ask the leader).
#   2. In its SQL Editor, run supabase/schema.sql once.
#   3. Copy both values from Project Settings -> API.
# These two ARE meant to carry NEXT_PUBLIC_: they are public values that ship to the browser.
# The rules in supabase/schema.sql protect the data. Never put the "service_role" key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Not used yet ---
# Email reminders are planned but not built, so they need no variables today.
# When they are added, list their variables here in the same commit.
