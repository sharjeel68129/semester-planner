# Copy this file to .env.local and fill in the real values:
#   copy .env.example .env.local
# .env.local is gitignored. Never commit it, paste it in chat, or screenshot it.
#
# Format: one NAME=value per line. No spaces around "=", no quotes, no trailing spaces.
# Restart "npm run dev" after editing; Next.js only reads this file at startup.

# --- Required ---

# Gemini API key (from https://aistudio.google.com/apikey; the team shares one, ask the leader).
# Server-side only. Never prefix with NEXT_PUBLIC_ or the key leaks to browsers.
GEMINI_API_KEY=your-key-here

# --- Optional ---

# Which Gemini model lib/extract.js calls. Leave commented out to use the model pinned there.
# Uncomment to switch without a code change, e.g. when the pinned model keeps answering
# 503 "high demand". Re-run the sample outlines after switching: accuracy can change.
# GEMINI_MODEL=gemini-3.5-flash

# --- Not used yet ---
# Accounts/database and email reminders are planned but not built, so they need no variables
# today. When they are added, list their variables here in the same commit.
